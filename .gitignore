# hoardCTI baseline ignores. This template serves repositories in several
# languages, so it covers more than any one project needs. Trim what does not
# apply, but keep the "Secrets and credentials" section in every repository.

# ---------------------------------------------------------------------------
# Secrets and credentials  (never relax these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
credentials
credentials.json
service-account*.json
.netrc
.npmrc
.pypirc
secrets.yml
secrets.yaml
*.secret
.aws/
.gnupg/

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.directory
.nfs*

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
nbproject/
.history/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.ipynb_checkpoints/
.python-version

# ---------------------------------------------------------------------------
# Node / JavaScript
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/cache/
.yarn/install-state.gz
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.cache/
coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
bin/
*.test
*.out

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
target/
**/*.rs.bk

# ---------------------------------------------------------------------------
# Java / JVM
# ---------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Infrastructure and containers
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc
crash.log
*.retry
.vagrant/

# ---------------------------------------------------------------------------
# Logs, databases, temporary and local files
# ---------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
.local/
.direnv/
.envrc
