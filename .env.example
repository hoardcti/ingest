# HoardCTI ingest configuration.
#
# Copy to .env for local development. .env is gitignored; .env.example is not,
# so never put a real credential in this file.
#
# Every variable is optional except HOARDCTI_DATABASE_URL. The values shown are
# the defaults unless noted.

# --- Database -----------------------------------------------------------
# Required. The only credential the ingest service holds — collectors have none.
HOARDCTI_DATABASE_URL=postgres://hoardcti:hoardcti@localhost:5432/hoardcti

# Must exceed HOARDCTI_QUEUE_WORKERS: each worker holds a transaction for the
# length of its batch, and startup refuses a configuration that cannot.
HOARDCTI_DATABASE_MAX_CONNS=16
HOARDCTI_DATABASE_MIN_CONNS=2
HOARDCTI_DATABASE_STATEMENT_TIMEOUT=5m

# Create a source row on first sight instead of rejecting the envelope.
# Convenient locally; off in production, where an unknown slug is nearly always
# a typo in a collector's configuration.
HOARDCTI_AUTO_REGISTER_SOURCES=false

# --- Redis / Valkey -----------------------------------------------------
# Carries the envelope queue and the indicator lookup cache. Without it the
# service can still `load` envelopes directly, but cannot `serve`.
HOARDCTI_REDIS_URL=redis://localhost:6379/0

# How long a cached verdict survives without being refreshed. Set this longer
# than your slowest feed's collection interval, or indicators drop out of the
# cache between collections.
HOARDCTI_CACHE_TTL=720h
HOARDCTI_CACHE_ENABLED=true

# --- Queue --------------------------------------------------------------
HOARDCTI_QUEUE_STREAM=hoardcti.envelopes
HOARDCTI_QUEUE_GROUP=ingest

# Must be stable across restarts: it is how a replica reclaims the messages it
# was holding when it died. Defaults to the hostname.
# HOARDCTI_QUEUE_CONSUMER=ingest-0

# How long a message must sit unacknowledged before another replica may claim
# it. Set this comfortably longer than your slowest legitimate batch, or
# replicas will steal work from each other mid-write.
HOARDCTI_QUEUE_MIN_IDLE=5m
HOARDCTI_QUEUE_CLAIM_INTERVAL=30s

# Approximate cap on stream length. An uncapped stream with a stalled consumer
# group will fill memory; 0 disables the cap.
HOARDCTI_QUEUE_MAX_LEN=1000000

HOARDCTI_QUEUE_WORKERS=4
HOARDCTI_QUEUE_BLOCK_TIMEOUT=5s

# Redeliveries before a message is treated as poison, parked in
# ingest_dead_letter, and acknowledged so the group can move on.
HOARDCTI_QUEUE_MAX_DELIVERIES=5

# --- Raw archive --------------------------------------------------------
# none | s3 | fs   ("r2" is accepted as an alias for s3)
#
# Leaving this at "none" means upstream payloads are not kept, and reprocessing
# history after a parser fix will require re-scraping — which for a good
# proportion of CTI sources is not possible.
HOARDCTI_ARCHIVE_BACKEND=none

# For the s3 backend. Cloudflare R2:
#   ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   REGION=auto
# HOARDCTI_ARCHIVE_BUCKET=hoardcti-raw
# HOARDCTI_ARCHIVE_ENDPOINT=
# HOARDCTI_ARCHIVE_REGION=auto
# HOARDCTI_ARCHIVE_ACCESS_KEY_ID=
# HOARDCTI_ARCHIVE_SECRET_ACCESS_KEY=
# Needed by MinIO and most self-hosted gateways.
# HOARDCTI_ARCHIVE_USE_PATH_STYLE=false

# For the fs backend.
# HOARDCTI_ARCHIVE_DIR=./.archive

# --- Ingest policy ------------------------------------------------------
# Proportion of records that may fail canonicalisation before the whole envelope
# is rejected. A few malformed lines in a feed are normal; a quarter of them
# means the format has changed and ingesting the remainder would lose data
# quietly.
HOARDCTI_INGEST_MAX_DROP_RATIO=0.25

# --- HTTP ---------------------------------------------------------------
# Serves /healthz, /readyz, /metrics and POST /v1/envelopes. Empty disables it
# entirely, which also removes the metrics endpoint.
HOARDCTI_HTTP_ADDR=:8080

# Comma-separated bearer tokens for the submission endpoint. With none set, the
# endpoint refuses every request rather than defaulting to open.
# HOARDCTI_HTTP_TOKENS=

HOARDCTI_HTTP_READ_TIMEOUT=30s
HOARDCTI_HTTP_WRITE_TIMEOUT=30s
HOARDCTI_HTTP_MAX_BODY_BYTES=33554432

# --- Logging ------------------------------------------------------------
# debug | info | warn | error
HOARDCTI_LOG_LEVEL=info
# json | text
HOARDCTI_LOG_FORMAT=json

# --- Tests --------------------------------------------------------------
# The store integration tests are skipped unless this is set. It must point at a
# database you are willing to have truncated.
# HOARDCTI_TEST_DATABASE_URL=postgres://hoardcti:hoardcti@localhost:5432/hoardcti_test
